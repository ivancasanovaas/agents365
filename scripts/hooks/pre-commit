#!/usr/bin/env bash
# Blocks commits that stage competition data or derived frame-level exports.
# Install (once per clone):  git config core.hooksPath scripts/hooks
set -u

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

bad=""
while IFS= read -r f; do
  case "$f" in
    data/README.md) continue ;;
    *.ipynb)
      # A notebook stores cell outputs: a df.head() would leave match rows inside the file. Refuse any with outputs.
      py="$(command -v python3 || command -v python || true)"
      if [ -n "$py" ] && ! git show ":$f" | "$py" -c 'import json,sys; nb=json.load(sys.stdin); sys.exit(1 if any(c.get("outputs") for c in nb.get("cells", [])) else 0)' 2>/dev/null; then
        bad="$bad\n  $f  (notebook with outputs: jupyter nbconvert --clear-output --inplace $f)"
      fi ;;
    data/*|*/data/*) bad="$bad\n  $f  (inside data/)" ;;
    *.parquet|*.feather|*.mp4|*.avi|*.mkv|*.npy|*.npz|*.pkl|*.pl3container|*.gzip) bad="$bad\n  $f  (data/derived format)" ;;
    *_atd.txt|*_atd.xml|*_homography.csv|*_smart_tagging.xml) bad="$bad\n  $f  (competition asset)" ;;
    *_possession_gt.csv|*_possession_gt_meta.json|*_possession_gt_reference.csv) bad="$bad\n  $f  (private ground truth)" ;;
    evaluation/results/baseline_*.csv|evaluation/gt/*) continue ;;   # tracked on purpose by the organisers
    *.csv) bad="$bad\n  $f  (a CSV: submissions and exports stay out of git; only the organisers' baselines are tracked)" ;;
    profile*.md|*/profile*.md|local_proposals.md|*/local_proposals.md|dgx_inventory.txt|*/dgx_inventory.txt)
      bad="$bad\n  $f  (match aggregates / generated analysis stay out of the public repo)" ;;
    outputs/*|runs/*) bad="$bad\n  $f  (generated output)" ;;
    evaluation/reports/*|evaluation/scoreboard.csv) bad="$bad\n  $f  (our predictions' reports)" ;;
  esac
done <<EOF
$staged
EOF

if [ -n "$bad" ]; then
  printf 'COMMIT BLOCKED: staged files that must never enter git:%b\n' "$bad" >&2
  echo "Unstage them (git restore --staged <file>) and add the pattern to .gitignore if missing." >&2
  exit 1
fi
exit 0
